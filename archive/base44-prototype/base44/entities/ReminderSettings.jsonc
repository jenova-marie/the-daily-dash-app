{
  "name": "ReminderSettings",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminders are enabled"
    },
    "times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of times in HH:MM format when to send push notifications"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}