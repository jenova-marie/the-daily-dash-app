{
  "name": "DailyChecklist",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "time_of_day": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "anytime"
      ]
    },
    "label": {
      "type": "string"
    },
    "label_color": {
      "type": "string",
      "default": "#3b82f6"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}