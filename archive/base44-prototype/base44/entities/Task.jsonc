{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_color": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "days_of_week",
        "occurrences"
      ]
    },
    "occurrences": {
      "type": "number",
      "default": 1,
      "description": "Total number of times this task needs to be completed"
    },
    "completed_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this task has been completed so far"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_completed_date": {
      "type": "string",
      "format": "date"
    },
    "google_task_id": {
      "type": "string"
    },
    "synced_to_schedule": {
      "type": "boolean",
      "default": false
    },
    "schedule_time": {
      "type": "string"
    },
    "links": {
      "type": "string",
      "description": "JSON array of resource URLs"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}