{
  "name": "SelectedCalendars",
  "type": "object",
  "properties": {
    "calendar_id": {
      "type": "string"
    },
    "calendar_name": {
      "type": "string"
    },
    "is_selected": {
      "type": "boolean",
      "default": true
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "calendar_id",
    "calendar_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}