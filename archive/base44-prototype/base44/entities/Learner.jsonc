{
  "name": "Learner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}