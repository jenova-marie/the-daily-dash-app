{
  "name": "Sync App Events to Google Calendar (Update)",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.source_type == \"custom\") and (.trigger.data.google_event_id != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ScheduleItem"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_app_events_to_google_calendar_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAppEventToGoogle",
            "args": {
              "event": "{{data}}",
              "eventAction": "update"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncAppEventToGoogle"
  }
}